; λproc demonstration corpus: 20 classic cocktails.
; Bar operations are not in the industrial machine database: they are
; defined freely (a quoted string instead of a machine id).
; Indices are indicative (cl for liquids, pieces for the rest).

(use
  (P  "muddle" :comm)
  (SH "shaker with ice, then strain" :comm)
  (ST "mixing glass, bar spoon (stir)" :comm)
  (M  "built in the glass" :comm)
  (F  "fine strainer (double strain)"))

(mat
  (rum-white "white rum")
  (rum-dark "dark rum")
  (cachaca "cachaca")
  (gin "gin")
  (vodka "vodka")
  (whiskey "rye whiskey or bourbon")
  (bourbon "bourbon")
  (cognac "cognac")
  (tequila "tequila blanco")
  (campari "Campari")
  (vermouth-sweet "sweet vermouth")
  (vermouth-dry "dry vermouth")
  (triple-sec "triple sec / Cointreau")
  (curacao "orange curacao")
  (coffee-liqueur "coffee liqueur")
  (lemon "lemon juice")
  (lime "lime juice")
  (cranberry "cranberry juice")
  (pineapple "pineapple juice")
  (tomato "tomato juice")
  (espresso "short espresso")
  (coconut "cream of coconut")
  (orgeat "orgeat syrup")
  (sugar-syrup "sugar syrup")
  (sugar "caster sugar")
  (mint "fresh mint leaves")
  (soda "soda water")
  (cola "cola")
  (ginger-beer "ginger beer")
  (egg-white "egg white")
  (angostura "Angostura bitters" :minor)
  (tabasco "Tabasco" :minor)
  (worcestershire "Worcestershire sauce" :minor))

(def mojito           (M (P mint8 sugar2 lime2) rum-white4 soda10))
(def daiquiri         (F (SH rum-white5 lime2 sugar-syrup1)))
(def margarita        (SH tequila5 triple-sec3 lime2))
(def cosmopolitan     (SH vodka4 triple-sec1 lime1 cranberry3))
(def negroni          (ST gin3 campari3 vermouth-sweet3))
(def old-fashioned    (ST whiskey6 sugar1 angostura))
(def manhattan        (ST whiskey5 vermouth-sweet2 angostura))
(def dry-martini      (ST gin6 vermouth-dry1))
(def whiskey-sour     (F (SH whiskey4 lemon3 sugar-syrup2 egg-white3)))
(def pina-colada      (SH rum-white3 coconut3 pineapple9))
(def mai-tai          (SH rum-dark4 curacao1 orgeat1 lime2))
(def caipirinha       (M (P lime4 sugar2) cachaca5))
(def moscow-mule      (M vodka4 lime1 ginger-beer12))
(def gin-fizz         (M (F (SH gin4 lemon3 sugar-syrup2)) soda8))
(def tom-collins      (M gin4 lemon3 sugar-syrup2 soda6))
(def bloody-mary      (ST vodka4 tomato12 lemon1 tabasco worcestershire))
(def espresso-martini (F (SH vodka4 coffee-liqueur2 espresso4)))
(def mint-julep       (M (P mint6 sugar1) bourbon6))
(def sidecar          (SH cognac4 triple-sec2 lemon2))
(def cuba-libre       (M rum-white5 cola12 lime1))
